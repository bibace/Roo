{
  "name": "roo",
  "version": "1.0.0",
  "private": true,
  "author": "nova",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibace/Roo.git"
  },
  "homepage": "https://github.com/bibace/Roo",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:chrome",
    "dev:chrome": "wxt -b chrome --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "npm run build:chrome",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv2",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "wxt prepare && vitest run",
    "test:e2e": "npm run test:e2e:chrome",
    "test:e2e:chrome": "node scripts/run-e2e.mjs chrome",
    "test:e2e:edge-target": "node scripts/run-e2e.mjs edge-target",
    "test:e2e:build": "npm run build:chrome && npm run test:e2e:chrome",
    "zip": "npm run zip:chrome",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "zip:all": "npm run zip:chrome && npm run zip:edge && npm run zip:firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2 --warnings-as-errors --self-hosted",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify:artifact": "npm run verify:chrome",
    "verify:chrome": "node scripts/verify-release.mjs chrome",
    "verify:edge": "node scripts/verify-release.mjs edge",
    "verify:firefox": "node scripts/verify-release.mjs firefox",
    "verify:all": "npm run verify:chrome && npm run verify:edge && npm run verify:firefox",
    "test:release": "npm test && npm run typecheck && npm run build:all && npm run test:e2e:chrome && npm run test:e2e:edge-target && npm run lint:firefox && npm run zip:all && npm run verify:all && npm ls --depth=0 && npm run audit && git diff --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.3"
  }
}
